# syntax=docker/dockerfile:1
# BreachSAFE QuReddy CBOM Viewer — reproducible viewer-only build of the PQCA/cbomkit frontend
# (Apache-2.0, orig. IBM). Builds the SPA from source (no pre-existing dist/) and serves it on nginx.
# The SPA is architecture-neutral. Compile it once on the native build platform instead of
# running npm under QEMU for every target architecture.
FROM --platform=$BUILDPLATFORM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# viewer-only, real title baked (dev mode avoids the .env.production placeholder substitution)
ENV VUE_APP_VIEWER_ONLY=true
RUN npx vue-cli-service build --mode development
# ---- serve stage ----
FROM nginx:alpine
COPY --from=build /app/dist /opt/app
COPY docker/etc/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 8000
