FROM nginx:alpine
COPY dist /usr/share/nginx/html
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && \
    printf 'server { listen 80; root /usr/share/nginx/html; location / { try_files $uri $uri/ /index.html; } }\n' > /etc/nginx/conf.d/default.conf
# entrypoint subs VUE_APP_*_value placeholders from env, then starts nginx
ENTRYPOINT ["/bin/sh","-c","APP_DIR=/usr/share/nginx/html /entrypoint.sh; nginx -g 'daemon off;'"]
